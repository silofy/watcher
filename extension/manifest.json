{
  "manifest_version": 3,
  "name": "Watcher Terminal Listener",
  "version": "0.1.0",
  "description": "Captures in-browser terminal telemetry and HTB machine lifecycle for local, private analysis.",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging", "storage", "scripting"],
  "host_permissions": ["https://*.hackthebox.com/*", "https://*.tryhackme.com/*", "https://labs.hackthebox.com/*", "https://0xdf.gitlab.io/*", "https://notes.ippsec.rocks/*"],
  "action": { "default_title": "The Watcher — recording status" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://*.hackthebox.com/*", "https://*.tryhackme.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.hackthebox.com/*", "https://*.tryhackme.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
